# Скопируйте в .env и заполните. Файл .env НЕЛЬЗЯ коммитить в git.

# Секретный ключ: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=depter.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://depter.example.com

# Адрес админки (подберите свой, не оставляйте угадываемый)
DJANGO_ADMIN_URL=control-panel

# Продакшен за Nginx с HTTPS: 1
DJANGO_BEHIND_PROXY=1
DJANGO_SECURE=1
DJANGO_HSTS_SECONDS=31536000

# PostgreSQL (если DB_NAME пуст, используется база из settings.py)
DB_NAME=depter
DB_USER=depter
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
